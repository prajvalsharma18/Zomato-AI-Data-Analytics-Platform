```gitignore
# =========================
# Credentials / Secrets
# =========================
Creds/
Creds
.env
.env.*
*.pem
*.key
profiles.yml

# =========================
# Data
# =========================
data/
*.csv

# =========================
# Python Virtual Environments
# =========================
.venv/
venv/
env/
airflow-venv/
dbt_venv/

# Any virtual environment folder
**/.venv/
**/venv/
**/env/
**/airflow-venv/
**/dbt_venv/

# =========================
# Python Cache / Build
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# =========================
# dbt
# =========================
zomato/target/
zomato/dbt_packages/
zomato/logs/

# =========================
# Airflow
# =========================
airflow/logs/
airflow/.airflowignore/

# =========================
# OS / IDE
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =========================
# Misc
# =========================
*.log
```
